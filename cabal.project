packages:
  prettychart.cabal
  ../chart-svg/chart-svg.cabal
  ../numhask-space/numhask-space.cabal
  ../numhask/numhask.cabal
  ../formatn/formatn.cabal
  ../circuits-parser/circuits-parser.cabal
  ../circuits/circuits.cabal
  ../harpie/harpie.cabal

constraints:
  circuits >= 0.2

write-ghc-environment-files: always

allow-newer:
  *:base,
  *:template-haskell,
  string-interpolate:template-haskell,
  tdigest:base
